menu "Radar LD2410"

    config RADAR_UART_NUM
        int "UART periferica del radar"
        default 1
        range 0 2

    config RADAR_BAUD
        int "Baud rate (default di fabbrica del modulo: 256000)"
        default 256000

    config RADAR_RX_GPIO
        int "GPIO RX (collegato al TX del radar)"
        default 26

    config RADAR_TX_GPIO
        int "GPIO TX (collegato all'RX del radar)"
        default 27

    config RADAR_OUT_GPIO
        int "GPIO del pin OUT del radar"
        default 25

    config RADAR_OUT_ENABLE
        bool "Usa il pin OUT come controllo incrociato / modalita degradata"
        default y

    config RADAR_EN_GPIO
        int "GPIO RADAR_EN (-1 = non cablato)"
        default -1
        range -1 48

    config RADAR_RX_BUFFER
        int "Buffer RX UART [byte]"
        default 1024
        range 1024 8192

    config RADAR_TRIGGER_MM
        int "Distanza di trigger [mm]"
        default 3000
        range 200 6000

    config RADAR_TRIGGER_ENERGY
        int "Energia minima del bersaglio in movimento per il trigger"
        default 20
        range 0 100

    config RADAR_CONFIRM_FRAMES
        int "Frame consecutivi di conferma del trigger"
        default 3
        range 1 10

    config RADAR_HOLD_MS
        int "Tenuta della presenza senza bersagli [ms]"
        default 3000
        range 0 60000

    config RADAR_HYSTERESIS_GATES
        int "Isteresi di uscita in cancelli di distanza"
        default 1
        range 0 4

    config RADAR_STATIC_TRIGGER
        bool "I bersagli solo fermi generano trigger (default: no)"
        default n

    config RADAR_MAX_MOVING_GATE
        int "Cancello massimo per bersagli in movimento (2..8)"
        default 8
        range 2 8

    config RADAR_MAX_STATIC_GATE
        int "Cancello massimo per bersagli fermi (2..8)"
        default 8
        range 2 8

    config RADAR_UNMANNED_S
        int "Durata 'nessuno presente' del modulo [s]"
        default 5
        range 0 65535

    config RADAR_FAULT_TIMEOUT_MS
        int "Silenzio UART oltre il quale il sensore e' in guasto [ms]"
        default 2000
        range 500 60000

    config RADAR_CAL_MARGIN
        int "Margine sopra il rumore nelle soglie proposte dalla calibrazione"
        default 10
        range 0 100

    config RADAR_CAL_SECONDS
        int "Durata di default della calibrazione [s]"
        default 60
        range 10 600

    config RADAR_TASK_STACK
        int "Stack del task radar [byte]"
        default 4096

endmenu
