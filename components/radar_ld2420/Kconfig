menu "Radar LD2420"

    config RADAR_UART_NUM
        int "UART periferica del radar"
        default 1
        range 0 2

    config RADAR_BAUD
        int "Baud rate (0 = auto-probe 115200/256000 secondo firmware del modulo)"
        default 0

    config RADAR_RX_GPIO
        int "GPIO RX (collegato alla seriale dati del modulo: OT2 fw<1.5.3, OT1 fw>=1.5.3)"
        default 26

    config RADAR_TX_GPIO
        int "GPIO TX (collegato al pin RX del modulo)"
        default 27

    config RADAR_OUT_GPIO
        int "GPIO dell'uscita presenza del modulo (OT1 fw<1.5.3, OT2 fw>=1.5.3)"
        default 25

    config RADAR_OUT_ENABLE
        bool "Usa l'uscita presenza del modulo come controllo incrociato / modalita degradata"
        default y

    config RADAR_EN_GPIO
        int "GPIO RADAR_EN (-1 = non cablato)"
        default -1
        range -1 48

    config RADAR_RX_BUFFER
        int "Buffer RX UART [byte]"
        default 1024
        range 1024 8192

    config RADAR_TRIGGER_MM
        int "Distanza di trigger [mm]"
        default 3000
        range 200 8000

    config RADAR_CONFIRM_FRAMES
        int "Frame consecutivi di conferma del trigger"
        default 3
        range 1 10

    config RADAR_HOLD_MS
        int "Tenuta della presenza senza bersagli [ms]"
        default 3000
        range 0 60000

    config RADAR_HYSTERESIS_MM
        int "Isteresi di uscita oltre la distanza di trigger [mm]"
        default 500
        range 0 2000

    config RADAR_MIN_GATE
        int "Cancello minimo di rilevazione (0..15)"
        default 1
        range 0 15

    config RADAR_MAX_GATE
        int "Cancello massimo di rilevazione (0..15, default di fabbrica 12)"
        default 12
        range 0 15

    config RADAR_UNMANNED_S
        int "Tenuta presenza del modulo [s] (parametro delay time)"
        default 5
        range 0 255

    config RADAR_FAULT_TIMEOUT_MS
        int "Silenzio UART oltre il quale il sensore e' in guasto [ms]"
        default 2000
        range 500 60000

    config RADAR_CAL_MOVE_PCT
        int "Soglia trigger proposta in calibrazione [% del picco di rumore]"
        default 250
        range 100 1000

    config RADAR_CAL_STILL_PCT
        int "Soglia keep proposta in calibrazione [% del picco di rumore]"
        default 225
        range 100 1000

    config RADAR_CAL_SECONDS
        int "Durata di default della calibrazione [s]"
        default 60
        range 10 600

    config RADAR_TASK_STACK
        int "Stack del task radar [byte]"
        default 4096

    config RADAR_TASK_WDT
        bool "Iscrivi il task radar al task watchdog"
        default y
        help
            Il task radar (poll UART e recovery) si alimenta a ogni giro:
            il loop e' gia' a passi limitati (poll RX, attese richieste e
            boot entrambi con timeout), quindi il feed non cambia i tempi.

endmenu
